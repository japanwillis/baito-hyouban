---
import Base from '../../layouts/Base.astro';
const pages=Object.values(import.meta.glob('./*.md',{eager:true}));
const articles=pages.filter(p=>['approved','conditionally-approved'].includes(p.frontmatter.editorialStatus)).map(p=>({title:p.frontmatter.title,url:p.url,description:p.frontmatter.description,image:p.frontmatter.heroImage}));
---
<Base title="職種別のバイト評判"><div class="page-head"><span class="eyebrow">JOB</span><h1>職種別のバイト評判</h1><p>仕事内容や研修、働き方を公的・公式情報と編集部の考察を分けて整理します。</p></div><div class="discovery-controls"><input id="list-search" type="search" placeholder="記事タイトル・キーワードで絞り込む" aria-label="記事一覧を絞り込む" /></div><p id="list-count" class="discovery-count" aria-live="polite"></p><div class="articles">{articles.map(a=><a class="feature-article list-item" href={a.url} data-title={a.title} data-description={a.description}><img src={a.image} alt="" width="1200" height="630" loading="lazy"/><div><h2>{a.title}</h2><p>{a.description}</p><strong>記事を読む →</strong></div></a>)}</div><p id="list-empty" class="discovery-empty" hidden>該当する記事がありません。</p><button id="list-more" class="discovery-more" type="button" hidden>さらに12件表示</button></Base>

<script>import '../../scripts/article-list.ts';</script>
<style>.list-item[hidden]{display:none!important}</style>
