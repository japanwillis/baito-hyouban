---
import Base from '../../layouts/Base.astro';
---
<Base title="ブラックバイト危険度チェック｜職場環境の気になるサイン" description="アルバイトの未払い賃金、休憩、シフト、ハラスメントなどの気になる状況を10問で確認。公的な相談先も紹介します。">
<nav class="breadcrumb"><a href="/">ホーム</a><span>›</span><span>職場環境セルフチェック</span></nav>
<section class="wc-hero"><span class="eyebrow">WORKPLACE CHECK</span><h1>そのバイト先、<em>大丈夫？</em></h1><p>10の質問で職場の気になるサインを整理。無料・登録不要。回答はブラウザ内だけで処理します。</p></section>
<div class="wc-layout">
<section class="wc-panel">
<div id="wc-intro"><h2>職場で気になることはありますか？</h2><p>「ある」「ない」「わからない」のいずれかを選んでください。法律違反の有無を診断するものではありません。</p><button id="wc-start" type="button">チェックを始める →</button></div>
<div id="wc-questions" hidden><div class="wc-progress"><strong id="wc-count"></strong><span id="wc-pct"></span></div><progress id="wc-bar" max="10" value="1"></progress><span id="wc-category" class="wc-tag"></span><h2 id="wc-question" tabindex="-1"></h2><p id="wc-hint"></p><div class="wc-answers"><button data-answer="yes" type="button">ある →</button><button data-answer="no" type="button">ない →</button><button data-answer="unknown" type="button">わからない →</button></div><button id="wc-back" class="wc-back" type="button">← 前の質問へ</button></div>
<div id="wc-results" hidden><span class="eyebrow">YOUR RESULT</span><h2 id="wc-result-title" tabindex="-1"></h2><p id="wc-summary"></p><p class="wc-status" id="wc-status"></p><h3>気になる点と対処のヒント</h3><div id="wc-flags"></div><div id="wc-unknown-wrap" hidden><h3>確認しておきたい項目</h3><ul id="wc-unknown"></ul></div><div class="wc-tip"><strong>今できること</strong><p>給与明細、勤務表、契約書、業務の指示などを可能な範囲で保存。困ったときは公的窓口や信頼できる人に相談してください。</p></div><p class="wc-note">結果は編集部による確認項目の整理です。違法性や安全性を断定しません。深刻な問題は項目数にかかわらず相談を。</p><div class="wc-actions"><button id="wc-retry" type="button">もう一度チェック</button><button id="wc-copy" type="button">結果をコピー</button><span id="wc-copied" role="status"></span></div></div>
</section>
<aside class="wc-side"><h2>公的な相談先</h2><p>働く条件や人間関係で困ったら、以下の窓口を利用できます。</p><a href="https://www.mhlw.go.jp/stf/seisakunitsuite/bunya/koyou_roudou/roudoukijun/kijyungaiyou/kijyungaiyou06.html">厚生労働省｜労働基準行政の相談窓口 →</a><a href="https://www.mhlw.go.jp/stf/seisakunitsuite/bunya/koyou_roudou/soudanmadogutitou/itiran/index.html">厚生労働省｜相談窓口一覧 →</a><a href="https://www.check-roudou.mhlw.go.jp/lp/arubaito/">アルバイトの労働条件を確認 →</a><p>身の危険が迫っている場合は、チェックより安全の確保を優先してください。</p></aside>
</div>
<section class="wc-related"><h2>応募前にも役立つ情報</h2><a href="/guide/labor-conditions-notice/">労働条件通知書 →</a><a href="/job-comparison/">バイト職種比較 →</a><a href="/diagnosis/">バイト適性診断 →</a></section>
<style>
.wc-hero{background:linear-gradient(110deg,#e9f5f3,#f3f8fb);border-radius:22px;padding:38px 43px}.wc-hero h1{font-size:clamp(28px,4.2vw,44px);line-height:1.4;margin:9px 0}.wc-hero h1 em{font-style:normal;color:#087d89}.wc-hero p{color:#53737d;max-width:650px}.wc-layout{display:grid;grid-template-columns:minmax(0,1fr) 280px;gap:24px;align-items:start;margin:32px 0 55px}.wc-panel{background:#fff;border:1px solid #dfebed;border-radius:19px;padding:32px;min-height:350px}.wc-panel h2{font-size:clamp(21px,3vw,29px);line-height:1.5}.wc-panel p{color:#56727a;font-size:14px}.wc-panel button{font:inherit;font-weight:700;cursor:pointer;border-radius:11px;padding:12px 17px}.wc-panel button:focus-visible{outline:3px solid #dfa83d;outline-offset:3px}#wc-start,#wc-retry{background:#087b85;color:#fff;border:0}.wc-progress{display:flex;align-items:center;justify-content:space-between;color:#4d737e;font-size:13px}#wc-bar{width:100%;height:10px;margin:14px 0 25px;accent-color:#087b85}.wc-tag{display:inline-block;background:#eaf6f3;color:#11717a;font-weight:700;font-size:12px;padding:4px 11px;border-radius:30px}#wc-answers{display:grid;gap:12px;margin:24px 0}#wc-answers button{width:100%;background:white;border:1px solid #d4e5e8;text-align:left;color:#254650}#wc-answers button:hover{background:#eaf8f5;border-color:#098491}.wc-back{border:0;background:none;color:#577a84;padding-left:0!important}.wc-status{background:#ecf8f5;border-radius:11px;padding:16px;font-weight:700}.wc-status[data-level="consult"]{background:#fff1e7;color:#8d431d!important}.wc-status[data-level="review"]{background:#fff7eb}.wc-flag{border:1px solid #dce9ec;padding:16px;border-radius:12px;margin:10px 0}.wc-flag strong{color:#284a54}.wc-flag p{margin:6px 0 0}.wc-tip{background:#f0f8f7;border-radius:12px;padding:18px;margin:22px 0}.wc-note{font-size:12px!important;color:#75858a!important}.wc-actions{display:flex;align-items:center;gap:11px;flex-wrap:wrap}.wc-actions button:not(#wc-retry){border:1px solid #a3c7cd;background:white;color:#176f7a}.wc-actions span{font-size:12px}.wc-side{background:#f3f8f9;border-radius:16px;padding:23px}.wc-side h2{font-size:20px}.wc-side p{color:#607983;font-size:13px}.wc-side a{display:block;font-size:13px;font-weight:700;margin:16px 0;overflow-wrap:anywhere}.wc-related{padding:0 0 70px}.wc-related h2{font-size:24px}.wc-related a{display:inline-block;font-size:14px;font-weight:700;margin:7px 18px 7px 0}.wc-panel [hidden]{display:none!important}@media(max-width:850px){.wc-layout{grid-template-columns:1fr}.wc-hero{padding:25px}.wc-panel{padding:22px}}
</style>
<script>
import {checkQuestions,evaluateWorkplace} from '../../lib/workplace-check.mjs';
const $=id=>document.getElementById(id);
let current=0;
let answers=[];
let last=null;
function showQuestion(){
  $('wc-intro').hidden=true;$('wc-results').hidden=true;$('wc-questions').hidden=false;
  const q=checkQuestions[current];
  $('wc-count').textContent='質問 '+(current+1)+' / '+checkQuestions.length;
  $('wc-pct').textContent=Math.round(100*(current+1)/checkQuestions.length)+'%';
  $('wc-bar').value=current+1;
  $('wc-category').textContent=q.category;
  $('wc-question').textContent=q.question;
  $('wc-hint').textContent=q.hint;
  $('wc-back').hidden=current===0;
  $('wc-question').focus({preventScroll:true});
}
function showResult(){
  last=evaluateWorkplace(answers);
  $('wc-questions').hidden=true;$('wc-results').hidden=false;
  $('wc-result-title').textContent=last.title;
  $('wc-summary').textContent='「ある」'+last.flags.length+'件、「わからない」'+last.unknowns.length+'件。';
  const msg=last.level==='consult'?'内容によっては早めの個別相談をおすすめします。':last.level==='review'?'複数の気になる点がありました。勤務条件と実態を確認しましょう。':last.level==='notice'?'記録を残して、状況を確認しましょう。':'選ばれた項目がなくても、問題がないと保証できるわけではありません。';
  $('wc-status').textContent=msg;
  $('wc-status').dataset.level=last.level;
  const list=$('wc-flags');list.replaceChildren();
  if(!last.flags.length){const p=document.createElement('p');p.textContent='「ある」と答えた項目はありません。';list.append(p);}
  last.flags.forEach(q=>{
    const item=document.createElement('article');item.className='wc-flag';
    const title=document.createElement('strong');title.textContent=q.category+'｜'+q.question;
    const hint=document.createElement('p');hint.textContent=q.action;
    item.append(title,hint);list.append(item);
  });
  const unknown=$('wc-unknown');unknown.replaceChildren();
  last.unknowns.forEach(q=>{const li=document.createElement('li');li.textContent=q.question;unknown.append(li);});
  $('wc-unknown-wrap').hidden=!last.unknowns.length;
  $('wc-result-title').focus({preventScroll:true});
  $('wc-results').scrollIntoView({behavior:'smooth',block:'start'});
}
$('wc-start').addEventListener('click',()=>{answers=[];current=0;showQuestion();});
document.querySelectorAll('[data-answer]').forEach(button=>button.addEventListener('click',()=>{
  answers[current]=button.dataset.answer;
  if(current===checkQuestions.length-1){showResult();}else{current++;showQuestion();}
}));
$('wc-back').addEventListener('click',()=>{if(current>0){current--;answers=answers.slice(0,current);showQuestion();}});
$('wc-retry').addEventListener('click',()=>{answers=[];current=0;showQuestion();});
$('wc-copy').addEventListener('click',async()=>{
  if(!last)return;
  const text=['職場環境セルフチェック',last.title,'ある：'+last.flags.length+'件','わからない：'+last.unknowns.length+'件',...last.flags.map(q=>'・'+q.question),'https://baito-hyouban.com/workplace-check/'].join('\n');
  try{await navigator.clipboard.writeText(text);$('wc-copied').textContent='コピーしました';}
  catch{$('wc-copied').textContent='コピーできませんでした';}
});
</script>
</Base>
