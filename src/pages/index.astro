---
import Base from '../layouts/Base.astro';
const pages = Object.values(import.meta.glob('./guide/*.md', {eager:true}));
const jobPages = Object.values(import.meta.glob('./job/*.md', {eager:true}));
const jobArticles = jobPages.filter(p=>['approved','conditionally-approved'].includes(p.frontmatter.editorialStatus));
const companyPages = Object.values(import.meta.glob('./company/*.md', {eager:true}));
const companyArticles = companyPages.filter(p=>['approved','conditionally-approved'].includes(p.frontmatter.editorialStatus));
const articles = pages.filter((p)=>['approved', 'conditionally-approved'].includes(p.frontmatter.editorialStatus)).map((p)=>({title:p.frontmatter.title,url:p.url,description:p.frontmatter.description,image:p.frontmatter.heroImage}));
---
<Base>
 <section class="hero"><div class="hero-copy"><span class="eyebrow">アルバイト選びをもっと安心に</span><h1>そのバイト、<br/><em>応募する前</em>に知っておこう。</h1><p>時給だけでは分からない仕事内容、シフト、面接、労働条件。最初の一歩を踏み出すための情報を、わかりやすくまとめます。</p><a class="primary-link" href="/guide/">バイトの基礎知識を読む <span>→</span></a></div><img src="/images/BH-0001-eyecatch.webp" alt="アルバイトを始める前に働き方を考える学生" width="1200" height="630" /></section>
 <section class="section tool-spotlights"><a class="anxiety-banner" href="/first-job-anxiety/"><span class="anxiety-banner-icon" aria-hidden="true">♡</span><span><strong>初バイト不安解消ナビ</strong><small>面接・ミス・人間関係・シフトなど12の悩みから、対処法と質問例を探せます。</small></span><b>悩みから探す →</b></a><a class="workplace-banner" href="/workplace-check/"><span class="workplace-banner-icon" aria-hidden="true">✓</span><span><strong>ブラックバイト危険度チェック</strong><small>賃金・休憩・シフトなど、職場の気になるサインを10問で確認。相談先も案内します。</small></span><b>無料でチェック →</b></a><a class="comparison-banner" href="/job-comparison/"><span class="comparison-banner-icon" aria-hidden="true">⇄</span><span><strong>バイト職種比較ツール</strong><small>コンビニ・カフェ・スーパーなど9職種から、気になる仕事を2〜3件並べて比較。</small></span><b>無料で比較する →</b></a><a class="salary-banner" href="/salary-calculator/"><span class="salary-banner-icon" aria-hidden="true">¥</span><span><strong>バイト月収シミュレーター</strong><small>時給とシフトから月収・年収を自動計算。2つの働き方も比較できます。</small></span><b>無料で計算する →</b></a><a class="diagnosis-banner" href="/diagnosis/"><span class="diagnosis-banner-icon" aria-hidden="true">✦</span><span><strong>あなたに向いているバイト診断</strong><small>10の質問で働き方の好みを整理。おすすめの仕事TOP5をチェック！</small></span><b>無料で診断する →</b></a></section>
 <section class="section"><div class="section-head"><span class="eyebrow">FIND YOUR WAY</span><h2>気になるテーマから探す</h2></div><div class="cards"><a class="category-card" href="/company/"><span class="emoji">🏪</span><h3>企業別の評判</h3><p>チェーン店ごとの仕事内容や働く条件を確認する。</p><span>調べる →</span></a><a class="category-card" href="/job/"><span class="emoji">💼</span><h3>職種別の評判</h3><p>飲食・販売・軽作業など仕事の特徴から比較する。</p><span>調べる →</span></a><a class="category-card" href="/guide/"><span class="emoji">📖</span><h3>バイトの基礎知識</h3><p>初めてのバイトや面接、労働条件の疑問を解消する。</p><span>読む →</span></a></div></section>
 <section class="section"><div class="section-head"><span class="eyebrow">GUIDE</span><h2>まず読んでほしい記事</h2></div><div class="articles">{articles.map(a=><a class="feature-article" href={a.url}><img src={a.image} alt="" width="1200" height="630" loading="lazy"/><div><span class="pill">応募前ガイド</span><h3>{a.title}</h3><p>{a.description}</p><strong>記事を読む →</strong></div></a>)}</div></section>
 <section class="section"><div class="section-head"><span class="eyebrow">COMPANY</span><h2>企業別のバイト評判</h2></div><div class="articles">{companyArticles.map(a=><a class="feature-article" href={a.url}><img src={a.frontmatter.heroImage} alt="" width="1200" height="630" loading="lazy"/><div><span class="pill">企業別の評判</span><h3>{a.frontmatter.title}</h3><p>{a.frontmatter.description}</p><strong>記事を読む →</strong></div></a>)}</div></section>
 <section class="section"><div class="section-head"><span class="eyebrow">JOB</span><h2>職種別のバイト評判</h2></div><div class="articles">{jobArticles.map(a=><a class="feature-article" href={a.url}><img src={a.frontmatter.heroImage} alt="" width="1200" height="630" loading="lazy"/><div><span class="pill">職種別の評判</span><h3>{a.frontmatter.title}</h3><p>{a.frontmatter.description}</p><strong>記事を読む →</strong></div></a>)}</div></section>
<style>
.anxiety-banner{display:flex;align-items:center;gap:20px;background:#f6f1f6;border:1px solid #ebdce9;border-radius:19px;text-decoration:none;color:#513b53;padding:25px 30px}.anxiety-banner:hover{background:#f2e9f1}.anxiety-banner-icon{display:grid;place-items:center;width:54px;height:54px;flex-shrink:0;border-radius:16px;background:#9b6b9e;color:#fff;font-size:30px}.anxiety-banner>span:nth-child(2){flex:1}.anxiety-banner strong{display:block;font-size:22px}.anxiety-banner small{display:block;color:#79667a;font-size:13px;margin-top:4px}.anxiety-banner b{font-size:14px;color:#875a8b;white-space:nowrap}@media(max-width:700px){.anxiety-banner{flex-wrap:wrap;padding:20px;gap:13px}.anxiety-banner strong{font-size:17px}.anxiety-banner b{width:100%;padding-left:65px}}
.workplace-banner{display:flex;align-items:center;gap:20px;background:#f5f3ed;border:1px solid #e9e0ce;border-radius:19px;color:#4b4034;text-decoration:none;padding:25px 30px}.workplace-banner:hover{background:#f1eadc}.workplace-banner-icon{display:grid;place-items:center;background:#9c7d46;color:#fff;border-radius:16px;width:54px;height:54px;flex-shrink:0;font-size:28px;font-weight:800}.workplace-banner>span:nth-child(2){flex:1}.workplace-banner strong{display:block;font-size:22px}.workplace-banner small{display:block;font-size:13px;color:#796a58;margin-top:4px}.workplace-banner b{white-space:nowrap;color:#8a6b37;font-size:14px}@media(max-width:700px){.workplace-banner{flex-wrap:wrap;padding:20px;gap:13px}.workplace-banner strong{font-size:17px}.workplace-banner b{width:100%;padding-left:65px}}
.comparison-banner{display:flex;align-items:center;gap:20px;background:#f1f4fc;border:1px solid #dce4f3;border-radius:19px;color:#173d52;text-decoration:none;padding:25px 30px}.comparison-banner:hover{background:#e9effc}.comparison-banner-icon{display:grid;place-items:center;width:54px;height:54px;background:#556ca3;color:white;border-radius:16px;flex-shrink:0;font-size:30px;font-weight:800}.comparison-banner>span:nth-child(2){flex:1}.comparison-banner strong{display:block;font-size:22px}.comparison-banner small{display:block;color:#62778e;font-size:13px;margin-top:4px}.comparison-banner b{white-space:nowrap;color:#4e659a;font-size:14px}@media(max-width:700px){.comparison-banner{flex-wrap:wrap;gap:13px;padding:20px}.comparison-banner strong{font-size:17px}.comparison-banner b{width:100%;padding-left:65px}}
.tool-spotlights{display:grid;gap:15px}.salary-banner{display:flex;align-items:center;gap:20px;background:#eaf4fa;border:1px solid #d4e6f2;color:#153847;text-decoration:none;border-radius:19px;padding:25px 30px;transition:background .2s}.salary-banner:hover{background:#e1eef6}.salary-banner-icon{display:grid;place-items:center;flex:none;background:#126e9c;color:#fff;width:54px;height:54px;border-radius:16px;font-size:28px;font-weight:900}.salary-banner>span:nth-child(2){flex:1}.salary-banner strong{display:block;font-size:22px}.salary-banner small{display:block;font-size:13px;color:#55747e;margin-top:4px}.salary-banner b{white-space:nowrap;color:#09658e;font-size:14px}@media(max-width:700px){.salary-banner{flex-wrap:wrap;padding:20px;gap:13px}.salary-banner strong{font-size:17px}.salary-banner b{width:100%;padding-left:65px}}
.diagnosis-banner{display:flex;align-items:center;gap:20px;background:#e5f5f3;border:1px solid #cbe9e4;color:#163e45;text-decoration:none;border-radius:19px;padding:25px 30px;transition:background .2s}.diagnosis-banner:hover{background:#d9eeea}.diagnosis-banner-icon{display:grid;place-items:center;flex:none;background:#107e89;color:#fff;width:54px;height:54px;border-radius:16px;font-size:32px}.diagnosis-banner>span:nth-child(2){flex:1}.diagnosis-banner strong{display:block;font-size:22px}.diagnosis-banner small{display:block;font-size:13px;color:#52747c;margin-top:4px}.diagnosis-banner b{white-space:nowrap;color:#087582;font-size:14px}@media(max-width:700px){.diagnosis-banner{flex-wrap:wrap;padding:20px;gap:13px}.diagnosis-banner strong{font-size:17px}.diagnosis-banner b{width:100%;padding-left:65px}}
</style>
</Base>

