---
import { isPublicArticle } from '../../lib/publication-eligibility';
import Base from '../../layouts/Base.astro';
const pages=Object.values(import.meta.glob('./*.md',{eager:true}));
const articles=pages.filter(p=>isPublicArticle(p.frontmatter)).map(p=>({title:p.frontmatter.title,url:p.url,description:p.frontmatter.description,image:p.frontmatter.heroImage}));
---
<Base title="企業別のバイト評判"><div class="page-head"><span class="eyebrow">COMPANY</span><h1>企業別のバイト評判</h1><p>チェーン店ごとの仕事内容、研修、働く条件を公式情報に基づいて紹介します。</p></div><div class="discovery-controls"><input id="list-search" type="search" placeholder="記事タイトル・キーワードで絞り込む" aria-label="記事一覧を絞り込む" /></div><p id="list-count" class="discovery-count" aria-live="polite"></p><div class="articles">{articles.map(a=><a class="feature-article list-item" href={a.url} data-title={a.title} data-description={a.description}><img src={a.image} alt="" width="1200" height="630"/><div><h2>{a.title}</h2><p>{a.description}</p><strong>記事を読む →</strong></div></a>)}</div><p id="list-empty" class="discovery-empty" hidden>該当する記事がありません。</p><button id="list-more" class="discovery-more" type="button" hidden>さらに12件表示</button></Base>

<script>import '../../scripts/article-list.ts';</script>
<style>.list-item[hidden]{display:none!important}.discovery-controls{display:flex;flex-wrap:wrap;gap:12px;margin:18px 0 26px}.discovery-controls input,.discovery-controls select{font:inherit;min-width:0;flex:1;border:1px solid #a8c3c8;border-radius:10px;padding:12px;background:#fff;color:#173443}.discovery-count{font-size:14px;color:#526e77;margin:12px 0}.discovery-more{display:block;margin:24px auto 40px;padding:12px 28px;border:1px solid #087a87;border-radius:12px;background:#fff;color:#076e7e;font:inherit;font-weight:700;cursor:pointer}.discovery-empty{padding:24px;background:#f3f8f8;border-radius:12px}.discovery-more[hidden],.discovery-empty[hidden]{display:none!important}a:focus-visible,button:focus-visible,input:focus-visible,select:focus-visible{outline:3px solid #087a87;outline-offset:3px}@media(max-width:600px){.discovery-controls{display:block}.discovery-controls input,.discovery-controls select{display:block;width:100%;margin:0 0 10px}}</style>
