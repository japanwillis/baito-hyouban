---
import Base from '../../layouts/Base.astro';
const pages=Object.values(import.meta.glob('./*.md',{eager:true}));
const articles=pages.filter(p=>['approved','conditionally-approved'].includes(p.frontmatter.editorialStatus)).map(p=>({title:p.frontmatter.title,url:p.url,description:p.frontmatter.description,image:p.frontmatter.heroImage}));
---
<Base title="企業別のバイト評判"><div class="page-head"><span class="eyebrow">COMPANY</span><h1>企業別のバイト評判</h1><p>チェーン店ごとの仕事内容、研修、働く条件を公式情報に基づいて紹介します。</p></div><div class="articles">{articles.map(a=><a class="feature-article" href={a.url}><img src={a.image} alt="" width="1200" height="630"/><div><h2>{a.title}</h2><p>{a.description}</p><strong>記事を読む →</strong></div></a>)}</div></Base>
